# AuraHire FastAPI Backend — Environment Variables
# =====================================================
# IMPORTANT: Never commit this file to GitHub.
# Add .env to your .gitignore file.

# PostgreSQL Database (Neon)
# Paste your full Neon connection string below.
# Format: postgresql://user:password@host/aurahire_db?sslmode=require
DATABASE_URL=postgresql://your-user:your-password@your-host/aurahire_db?sslmode=require

# FastAPI Settings
APP_ENV=development
APP_PORT=8000

